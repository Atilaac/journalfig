# GENERATED by journalfig._stylegen from SPECS -- do not edit.
# Change the JournalSpec in _specs.py and run `python -m journalfig._stylegen`.
# Shared settings live in _base.mplstyle, which is hand-written and applied first.
#
# IEEE figure style
# Spec: https://conferences.ieeeauthorcenter.ieee.org/write-your-paper/improve-your-graphics/
#   IEEE Author Center, Improve Your Graphics, retrieved 2026-08-24
#   widths: double 181.9 mm, single 88.9 mm

# Single column at the inverse golden ratio, the same default journalfig.figsize() applies, so a
# bare plt.subplots() here and jf.subplots(..., width="single") agree.
figure.figsize:                 3.500000, 2.163119
figure.titlesize:               9

font.family:                    sans-serif
font.sans-serif:                Arial, Helvetica, Helvetica Neue, Nimbus Sans, Liberation Sans, DejaVu Sans
font.size:                      9

mathtext.fontset:               custom
mathtext.rm:                    Arial
mathtext.it:                    Arial:italic
mathtext.bf:                    Arial:bold
mathtext.sf:                    Arial
mathtext.tt:                    Courier New

axes.linewidth:                 0.6
axes.labelsize:                 9
axes.titlesize:                 9
axes.titleweight:               bold
axes.titlelocation:             left

xtick.labelsize:                9
xtick.major.size:               3
xtick.major.width:              0.6
xtick.major.pad:                2.5
xtick.minor.size:               1.8
xtick.minor.width:              0.5

ytick.labelsize:                9
ytick.major.size:               3
ytick.major.width:              0.6
ytick.major.pad:                2.5
ytick.minor.size:               1.8
ytick.minor.width:              0.5

# markersize 4 pt = 1.41 mm printed.
lines.markersize:               4
lines.markeredgewidth:          0.7

patch.linewidth:                0.6
hatch.linewidth:                0.6
grid.linewidth:                 0.5
errorbar.capsize:               2

legend.fontsize:                9
legend.title_fontsize:          9
legend.handlelength:            1.8
