# GENERATED by journalfig._stylegen from SPECS -- do not edit.
# Change the JournalSpec in _specs.py and run `python -m journalfig._stylegen`.
# Shared settings live in _base.mplstyle, which is hand-written and applied first.
#
# Nature Portfolio figure style
# Spec: https://www.nature.com/documents/nature-final-artwork.pdf
#   Nature Portfolio, Guide to Preparing Final Artwork, retrieved 2026-07-28
#   widths: double 183 mm, onehalf 120 mm, onehalf_wide 136 mm, single 89 mm
#   text 5-7 pt; sub/superscripts >= 5 pt; raster >= 300 dpi
#
# RGB colour space; supply editable vector artwork with live (non-outlined) text.
#
# Panel labels are 8 pt where body text caps at 7 pt, so check() exempts them by gid.

# Single column at the inverse golden ratio, the same default journalfig.figsize() applies, so a
# bare plt.subplots() here and jf.subplots(..., width="single") agree.
figure.figsize:                 3.503937, 2.165552
figure.titlesize:               7

font.family:                    sans-serif
font.sans-serif:                Arial, Helvetica, Helvetica Neue, Nimbus Sans, Liberation Sans, DejaVu Sans
font.size:                      7

mathtext.fontset:               custom
mathtext.rm:                    Arial
mathtext.it:                    Arial:italic
mathtext.bf:                    Arial:bold
mathtext.sf:                    Arial
mathtext.tt:                    Courier New

axes.linewidth:                 0.5
axes.labelsize:                 7
axes.titlesize:                 7
axes.titleweight:               bold
axes.titlelocation:             left

xtick.labelsize:                6
xtick.major.size:               2.5
xtick.major.width:              0.5
xtick.major.pad:                2
xtick.minor.size:               1.5
xtick.minor.width:              0.4

ytick.labelsize:                6
ytick.major.size:               2.5
ytick.major.width:              0.5
ytick.major.pad:                2
ytick.minor.size:               1.5
ytick.minor.width:              0.4

# markersize 3 pt = 1.06 mm printed.
lines.markersize:               3
lines.markeredgewidth:          0.6

patch.linewidth:                0.5
hatch.linewidth:                0.5
grid.linewidth:                 0.4
errorbar.capsize:               1.5

legend.fontsize:                6
legend.title_fontsize:          6
legend.handlelength:            1.6
