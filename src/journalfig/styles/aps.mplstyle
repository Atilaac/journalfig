# GENERATED by journalfig._stylegen from SPECS -- do not edit.
# Change the JournalSpec in _specs.py and run `python -m journalfig._stylegen`.
# Shared settings live in _base.mplstyle, which is hand-written and applied first.
#
# American Physical Society (PRB/PRL) figure style
# Spec: https://res.cloudinary.com/apsphysics/image/upload/v1715884920/aps-journals-style-guide_tnoyln.pdf
#   APS Journals Style Guide for Authors, retrieved 2026-07-28
#   widths: double 177.8 mm, onehalf 134.9 mm, single 85.72 mm
#   lettering >= 2 mm; data points >= 1 mm; lines >= 0.5 pt; raster >= 600 dpi
#
# 9 pt is not cosmetic: Times New Roman digits measure 1.94 mm at 8 pt and 2.18 mm at
# 9 pt, so 8 pt fails the 2 mm lettering rule.
#
# Axis units go in parentheses; subfigures are labelled (a), (b).

# Single column at the inverse golden ratio, the same default journalfig.figsize() applies, so a
# bare plt.subplots() here and jf.subplots(..., width="single") agree.
figure.figsize:                 3.375000, 2.085865
figure.titlesize:               9

font.family:                    serif
font.serif:                     Times New Roman, Times, Nimbus Roman, Liberation Serif, STIXGeneral, DejaVu Serif
font.size:                      9

mathtext.fontset:               stix

axes.linewidth:                 0.6
axes.labelsize:                 9
axes.titlesize:                 9
axes.titleweight:               normal
axes.titlelocation:             center

xtick.labelsize:                9
xtick.major.size:               3
xtick.major.width:              0.6
xtick.major.pad:                2.5
xtick.minor.size:               1.8
xtick.minor.width:              0.5

ytick.labelsize:                9
ytick.major.size:               3
ytick.major.width:              0.6
ytick.major.pad:                2.5
ytick.minor.size:               1.8
ytick.minor.width:              0.5

# markersize 4 pt = 1.41 mm printed, clearing the 1 mm data-point rule.
lines.markersize:               4
lines.markeredgewidth:          0.7

patch.linewidth:                0.6
hatch.linewidth:                0.6
grid.linewidth:                 0.5
errorbar.capsize:               2

legend.fontsize:                9
legend.title_fontsize:          9
legend.handlelength:            1.8
