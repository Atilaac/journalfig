# Shared base for every journalfig theme.
#
# GENERATED OVERLAYS SIT ON TOP OF THIS FILE. Everything here is identical across all themes: it is a
# rendering or output choice that no publisher varies, so it is written once rather than copied per
# journal. Anything that differs between journals lives in that journal's own <key>.mplstyle, which is
# generated from SPECS by journalfig._stylegen -- edit the spec, not the overlay.
#
# This file is hand-written and is not generated. The leading underscore keeps register() from
# offering it to matplotlib as a theme in its own right.

figure.dpi:                     600
figure.facecolor:               white
figure.edgecolor:               white
figure.constrained_layout.use:  True
figure.constrained_layout.h_pad: 0.02
figure.constrained_layout.w_pad: 0.02
figure.constrained_layout.hspace: 0.04
figure.constrained_layout.wspace: 0.04
figure.titleweight:             bold

font.weight:                    normal

# "it" keeps variables italic, as scientific notation requires; "regular" would set them upright.
mathtext.default:               it

text.usetex:                    False
text.color:                     black

axes.facecolor:                 white
axes.edgecolor:                 black
axes.grid:                      False
axes.axisbelow:                 True
axes.labelcolor:                black
axes.labelpad:                  2.0
axes.titlepad:                  3.0
axes.formatter.use_mathtext:    True
axes.formatter.limits:          -3, 4
# True minus (U+2212) rather than an ASCII hyphen in tick labels. With axes.formatter.use_mathtext
# on -- as it is below -- this makes no visible difference, because mathtext already typesets a
# hyphen as a proper minus; measured pixel-identical. It matters only if a user turns that off,
# where the hyphen is narrower and sits lower than a minus. Kept because it costs nothing.
axes.unicode_minus:             True
axes.spines.top:                True
axes.spines.right:              True
axes.spines.left:               True
axes.spines.bottom:             True
axes.prop_cycle:                cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', 'F0E442', '000000']) + cycler('linestyle', ['-', '--', '-.', ':', '-', '--', '-.', ':'])

xtick.direction:                in
xtick.top:                      True
xtick.bottom:                   True
xtick.minor.visible:            True
xtick.color:                    black

ytick.direction:                in
ytick.left:                     True
ytick.right:                    True
ytick.minor.visible:            True
ytick.color:                    black

lines.linewidth:                1.0
lines.solid_capstyle:           round
lines.antialiased:              True
# Render every vertex. matplotlib's default threshold of 0.111 silently drops points: on a dense
# noisy trace that measured 11% of pixels different at 100 dpi, so the exported curve is not the
# curve that was plotted. The cost is file size -- a 20k-point line goes from 21 kB to 194 kB in
# PDF. Where that matters, pass rasterized=True to the artist rather than discarding data; check()
# says so when a figure gets heavy enough for it to count.
path.simplify:                  True
path.simplify_threshold:        0.0

grid.color:                     b0b0b0
grid.alpha:                     0.5

legend.frameon:                 False
legend.handletextpad:           0.5
legend.labelspacing:            0.3
legend.columnspacing:           1.0
legend.borderaxespad:           0.4
legend.borderpad:               0.3

image.cmap:                     viridis
image.interpolation:            nearest
image.origin:                   lower
scatter.marker:                 o

# Vector output with live, editable text. Type 42 embeds TrueType outlines rather than the Type 3
# bitmaps matplotlib defaults to, which every publisher's prepress rejects; svg.fonttype: none keeps
# SVG text as text. journalfig.save(svg_text="path") outlines it per-write when that is wanted.
pdf.fonttype:                   42
ps.fonttype:                    42
svg.fonttype:                   none
pdf.compression:                6
# Publishers state a raster resolution *floor*, not a target -- 300 for Nature, 500 for Elsevier
# combination art, 600 for APS -- so 600 clears all three with margin. JournalSpec.raster_dpi carries
# each floor, and a theme whose floor exceeds this overrides it in its own overlay.
savefig.dpi:                    600
savefig.format:                 pdf
savefig.bbox:                   standard
savefig.pad_inches:             0.0
savefig.facecolor:              white
savefig.edgecolor:              white
savefig.transparent:            False
