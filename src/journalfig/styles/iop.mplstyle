# GENERATED by journalfig._stylegen from SPECS -- do not edit.
# Change the JournalSpec in _specs.py and run `python -m journalfig._stylegen`.
# Shared settings live in _base.mplstyle, which is hand-written and applied first.
#
# IOP Publishing figure style
# Spec: https://publishingsupport.iopscience.iop.org/questions/figures-journal-articles/
#   IOP Publishing, Figures for journal articles, retrieved 2026-08-24
#   widths: double 150 mm, single 85 mm
#   text 8-12 pt
#
# IOP states no resolution requirement, so save() writes at the theme's own 600 dpi.

# Single column at the inverse golden ratio, the same default journalfig.figsize() applies, so a
# bare plt.subplots() here and jf.subplots(..., width="single") agree.
figure.figsize:                 3.346457, 2.068224
figure.titlesize:               8

font.family:                    serif
font.serif:                     Times New Roman, Times, Nimbus Roman, Liberation Serif, STIXGeneral, DejaVu Serif
font.size:                      8

mathtext.fontset:               stix

axes.linewidth:                 0.6
axes.labelsize:                 8
axes.titlesize:                 8
axes.titleweight:               normal
axes.titlelocation:             center

xtick.labelsize:                8
xtick.major.size:               3
xtick.major.width:              0.6
xtick.major.pad:                2.5
xtick.minor.size:               1.8
xtick.minor.width:              0.5

ytick.labelsize:                8
ytick.major.size:               3
ytick.major.width:              0.6
ytick.major.pad:                2.5
ytick.minor.size:               1.8
ytick.minor.width:              0.5

# markersize 4 pt = 1.41 mm printed.
lines.markersize:               4
lines.markeredgewidth:          0.7

patch.linewidth:                0.6
hatch.linewidth:                0.6
grid.linewidth:                 0.5
errorbar.capsize:               2

legend.fontsize:                8
legend.title_fontsize:          8
legend.handlelength:            1.8
