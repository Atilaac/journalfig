# GENERATED by journalfig._stylegen from SPECS -- do not edit.
# Change the JournalSpec in _specs.py and run `python -m journalfig._stylegen`.
# Shared settings live in _base.mplstyle, which is hand-written and applied first.
#
# ACS Publications figure style
# Spec: https://researcher-resources.acs.org/publish/author_guidelines?coden=accacs
#   ACS Publications, Author Guidelines (ACS Catalysis), retrieved 2026-08-24
#   widths: double 177.8 mm, single 84.7 mm
#   raster >= 300 dpi
#
# ACS accepts lettering down to 4.5 pt, far below what the other themes allow. check()
# enforces what the document says, so it will pass text most readers cannot read.
#
# Black-and-white line art wants 1200 dpi; the 300 dpi floor here is ACS's colour-art
# figure, which is what save() writes as a PNG companion.

# Single column at the inverse golden ratio, the same default journalfig.figsize() applies, so a
# bare plt.subplots() here and jf.subplots(..., width="single") agree.
figure.figsize:                 3.334646, 2.060924
figure.titlesize:               8

font.family:                    sans-serif
font.sans-serif:                Arial, Helvetica, Helvetica Neue, Nimbus Sans, Liberation Sans, DejaVu Sans
font.size:                      8

mathtext.fontset:               custom
mathtext.rm:                    Arial
mathtext.it:                    Arial:italic
mathtext.bf:                    Arial:bold
mathtext.sf:                    Arial
mathtext.tt:                    Courier New

axes.linewidth:                 0.6
axes.labelsize:                 8
axes.titlesize:                 8
axes.titleweight:               bold
axes.titlelocation:             left

xtick.labelsize:                8
xtick.major.size:               3
xtick.major.width:              0.6
xtick.major.pad:                2.5
xtick.minor.size:               1.8
xtick.minor.width:              0.5

ytick.labelsize:                8
ytick.major.size:               3
ytick.major.width:              0.6
ytick.major.pad:                2.5
ytick.minor.size:               1.8
ytick.minor.width:              0.5

# markersize 4 pt = 1.41 mm printed.
lines.markersize:               4
lines.markeredgewidth:          0.7

patch.linewidth:                0.6
hatch.linewidth:                0.6
grid.linewidth:                 0.5
errorbar.capsize:               2

legend.fontsize:                8
legend.title_fontsize:          8
legend.handlelength:            1.8
