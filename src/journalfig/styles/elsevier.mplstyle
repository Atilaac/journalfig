# GENERATED by journalfig._stylegen from SPECS -- do not edit.
# Change the JournalSpec in _specs.py and run `python -m journalfig._stylegen`.
# Shared settings live in _base.mplstyle, which is hand-written and applied first.
#
# Elsevier figure style
# Spec: https://www.elsevier.com/about/policies-and-standards/author/artwork-and-media-instructions/artwork-sizing
#   Elsevier, Artwork sizing, retrieved 2026-07-28
#   widths: double 190 mm, onehalf 140 mm, single 90 mm
#   sub/superscripts >= 6 pt; raster >= 500 dpi
#
# matplotlib renders maths sub/superscripts at 0.7x, so a 7 pt label puts "$x_a$" at
# 4.9 pt, under the 6 pt floor. Use journalfig.use("elsevier", base_size=9) for
# maths-heavy figures, and journalfig.check(fig) to see the rendered sizes.

# Single column at the inverse golden ratio, the same default journalfig.figsize() applies, so a
# bare plt.subplots() here and jf.subplots(..., width="single") agree.
figure.figsize:                 3.543307, 2.189884
figure.titlesize:               7

font.family:                    sans-serif
font.sans-serif:                Arial, Helvetica, Helvetica Neue, Nimbus Sans, Liberation Sans, DejaVu Sans
font.size:                      7

mathtext.fontset:               custom
mathtext.rm:                    Arial
mathtext.it:                    Arial:italic
mathtext.bf:                    Arial:bold
mathtext.sf:                    Arial
mathtext.tt:                    Courier New

axes.linewidth:                 0.6
axes.labelsize:                 7
axes.titlesize:                 7
axes.titleweight:               bold
axes.titlelocation:             left

xtick.labelsize:                7
xtick.major.size:               2.8
xtick.major.width:              0.6
xtick.major.pad:                2
xtick.minor.size:               1.6
xtick.minor.width:              0.5

ytick.labelsize:                7
ytick.major.size:               2.8
ytick.major.width:              0.6
ytick.major.pad:                2
ytick.minor.size:               1.6
ytick.minor.width:              0.5

# markersize 3.5 pt = 1.23 mm printed.
lines.markersize:               3.5
lines.markeredgewidth:          0.6

patch.linewidth:                0.6
hatch.linewidth:                0.6
grid.linewidth:                 0.5
errorbar.capsize:               1.8

legend.fontsize:                7
legend.title_fontsize:          7
legend.handlelength:            1.6
