# GENERATED by journalfig._stylegen from SPECS -- do not edit.
# Change the JournalSpec in _specs.py and run `python -m journalfig._stylegen`.
# Shared settings live in _base.mplstyle, which is hand-written and applied first.
#
# PNAS figure style
# Spec: https://www.pnas.org/pb-assets/authors/digitalart-1675347574760.pdf
#   PNAS, Digital Art Guidelines, retrieved 2026-08-24
#   widths: double 178 mm, onehalf 114 mm, single 87 mm
#   lines >= 0.25 pt; raster >= 600 dpi
#
# PNAS asks for LZW compression on TIFFs and never JPEG compression, which is what this
# package writes by default. Colour must be supplied as RGB.

# Single column at the inverse golden ratio, the same default journalfig.figsize() applies, so a
# bare plt.subplots() here and jf.subplots(..., width="single") agree.
figure.figsize:                 3.425197, 2.116888
figure.titlesize:               8

font.family:                    sans-serif
font.sans-serif:                Arial, Helvetica, Helvetica Neue, Nimbus Sans, Liberation Sans, DejaVu Sans
font.size:                      8

mathtext.fontset:               custom
mathtext.rm:                    Arial
mathtext.it:                    Arial:italic
mathtext.bf:                    Arial:bold
mathtext.sf:                    Arial
mathtext.tt:                    Courier New

axes.linewidth:                 0.6
axes.labelsize:                 8
axes.titlesize:                 8
axes.titleweight:               bold
axes.titlelocation:             left

xtick.labelsize:                8
xtick.major.size:               3
xtick.major.width:              0.6
xtick.major.pad:                2.5
xtick.minor.size:               1.8
xtick.minor.width:              0.5

ytick.labelsize:                8
ytick.major.size:               3
ytick.major.width:              0.6
ytick.major.pad:                2.5
ytick.minor.size:               1.8
ytick.minor.width:              0.5

# markersize 4 pt = 1.41 mm printed.
lines.markersize:               4
lines.markeredgewidth:          0.7

patch.linewidth:                0.6
hatch.linewidth:                0.6
grid.linewidth:                 0.5
errorbar.capsize:               2

legend.fontsize:                8
legend.title_fontsize:          8
legend.handlelength:            1.8
